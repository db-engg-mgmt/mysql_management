# my.cnf starting point for a dedicated MySQL 8.0 / 8.4 InnoDB server.
# Not a tuning guide - just the stuff I change on every new box. Adjust sizes for the hardware.
# Assumes 64GB RAM, SSD/NVMe, replication with GTID.

[mysqld]
# --- basics
server_id                       = 101
datadir                         = /var/lib/mysql
socket                          = /var/lib/mysql/mysql.sock
pid_file                        = /var/run/mysqld/mysqld.pid
skip_name_resolve               = ON
character_set_server            = utf8mb4
collation_server                = utf8mb4_0900_ai_ci
default_time_zone               = '+00:00'
sql_mode                        = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# --- connections
max_connections                 = 1000
thread_cache_size               = 100
wait_timeout                    = 600
interactive_timeout             = 600
max_allowed_packet              = 256M

# --- innodb
innodb_buffer_pool_size         = 48G
innodb_buffer_pool_instances    = 8
innodb_redo_log_capacity        = 8G              # 8.0.30+, else innodb_log_file_size
innodb_flush_log_at_trx_commit  = 1
innodb_flush_method             = O_DIRECT
innodb_io_capacity              = 2000
innodb_io_capacity_max          = 4000
innodb_file_per_table           = ON
innodb_print_all_deadlocks      = ON
innodb_lock_wait_timeout        = 30
innodb_undo_log_truncate        = ON

# --- tables / temp
table_open_cache                = 4000
table_definition_cache          = 4000
tmp_table_size                  = 64M
max_heap_table_size             = 64M

# --- binlog / replication
log_bin                         = binlog
binlog_format                   = ROW
binlog_row_image                = FULL
sync_binlog                     = 1
binlog_expire_logs_seconds      = 604800          # 7 days
gtid_mode                       = ON
enforce_gtid_consistency        = ON
relay_log_recovery              = ON
replica_parallel_workers        = 8
replica_preserve_commit_order   = ON
# on replicas:
# super_read_only               = ON

# --- logging
log_error                       = /var/log/mysql/error.log
slow_query_log                  = ON
slow_query_log_file             = /var/log/mysql/slow.log
long_query_time                 = 1
log_slow_extra                  = ON

# --- security
local_infile                    = OFF
secure_file_priv                = /var/lib/mysql-files
require_secure_transport        = ON

[client]
socket                          = /var/lib/mysql/mysql.sock
